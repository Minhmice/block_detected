{
  "_comment": "Example camera profiles for block_detected capture",
  "active_profile": "image_sequence",
  "defaults": {
    "width": 640,
    "height": 480,
    "warmup_frames": 5,
    "lock_exposure": true,
    "lock_white_balance": true
  },
  "profiles": {
    "image_sequence": {
      "_comment": "Offline dev — point image_dir at tests/fixtures/frames",
      "backend": "image_sequence",
      "image_dir": "images",
      "glob_pattern": "*.png"
    },
    "picamera2": {
      "_comment": "Raspberry Pi CSI via picamera2 (apt, not pip)",
      "backend": "picamera2"
    },
    "usb": {
      "_comment": "USB UVC via OpenCV VideoCapture",
      "backend": "usb",
      "camera_index": 0,
      "device_path": null
    }
  },
  "debug": {
    "enabled": false,
    "directory": "debug_frames",
    "every_n_frames": 1,
    "max_files": 200,
    "run_id": null
  }
}
