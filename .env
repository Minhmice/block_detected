# Backend
# Real camera on dev Mac: copy .env.real.example → .env and grant Terminal camera permission
EI_MODELS_CONFIG=config/eim_models.json
EI_MODEL_ID=shit-v1
EI_MODEL_PATH=
VISION_MOCK_MODE=true
MOCK_CAMERA=true
DETECTION_MODE=mock
CORS_ORIGINS=http://localhost:3000
CAMERA_CONFIG=config/camera.example.json
VISION_CONFIG=config/vision.example.json
CALIBRATION_PATH=config/calibration.json
DATASET_DIR=datasets/captured
HOST=127.0.0.1
PORT=8000

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/detection
NEXT_PUBLIC_STREAM_URL=http://127.0.0.1:8000/video/stream
